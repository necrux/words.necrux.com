{% extends "base.html.j2" %}

{% block title %}
Practice Spelling Test | {{ display.site.title }}
{% endblock %}

{% block content %}

<div class="practice-test">

    <h1>Practice Spelling Test</h1>

    <p class="instructions">
        Listen to each word, write it down, then reveal the word to check
        your spelling.
    </p>

    <h2>Words</h2>

    <div class="practice-words">
    {% for word in test.enriched_words %}
        <div class="practice-word">

            <span class="word-number">
                {{ loop.index }}.
            </span>

            {% if word.audio %}
            <button
                type="button"
                class="audio-button"
                data-audio="{{ word.audio }}"
                aria-label="Play word {{ loop.index }}"
                title="Play word"
            >
                🔊
            </button>
            {% endif %}

            <span class="hidden-word">
                {{ word.word }}
            </span>

            <button
                type="button"
                class="reveal-button"
                aria-label="Reveal word {{ loop.index }}"
            >
                Reveal Word
            </button>

        </div>
    {% endfor %}
    </div>

    {% if test.enriched_challenge_words %}
    <h2>Challenge Words</h2>

    <div class="practice-words">
    {% for word in test.enriched_challenge_words %}
        <div class="practice-word">

            <span class="word-number">
                {{ loop.index }}.
            </span>

            {% if word.audio %}
            <button
                type="button"
                class="audio-button"
                data-audio="{{ word.audio }}"
                aria-label="Play challenge word {{ loop.index }}"
                title="Play word"
            >
                🔊
            </button>
            {% endif %}

            <span class="hidden-word">
                {{ word.word }}
            </span>

            <button
                type="button"
                class="reveal-button"
                aria-label="Reveal challenge word {{ loop.index }}"
            >
                Reveal Word
            </button>

        </div>
    {% endfor %}
    </div>
    {% endif %}

    <p class="back-link">
        <a href="index.html">← Back to Test</a>
    </p>

</div>

{% endblock %}