<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{{ display.site.title }}{% endblock %}</title>

    <script>
        const initialTheme = localStorage.getItem("theme");

        if (
            initialTheme === "dark" ||
            (
                initialTheme !== "light" &&
                window.matchMedia("(prefers-color-scheme: dark)").matches
            )
        ) {
            document.documentElement.classList.add("dark");
        }
    </script>

    <style>
        :root {
            --background: {{ display.colors.light.background }};
            --foreground: {{ display.colors.light.foreground }};
            --accent: {{ display.colors.light.accent }};
            --muted: {{ display.colors.light.muted }};
            --border: {{ display.colors.light.border }};

            --body-font: {{ display.fonts.body }};
            --heading-font: {{ display.fonts.heading }};
            --body-size: {{ display.font_sizes.body }};
            --max-width: {{ display.layout.max_width }};
        }

        html.dark {
            --background: {{ display.colors.dark.background }};
            --foreground: {{ display.colors.dark.foreground }};
            --accent: {{ display.colors.dark.accent }};
            --muted: {{ display.colors.dark.muted }};
            --border: {{ display.colors.dark.border }};
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--background);
            color: var(--foreground);
            font-family: var(--body-font);
            font-size: var(--body-size);
            line-height: 1.6;
            margin: 0;
        }

        main {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 2rem;
            padding-bottom: 5rem;
        }

        a {
            color: var(--accent);
        }

        h1,
        h2,
        h3 {
            font-family: var(--heading-font);
        }

        details {
            border: 1px solid var(--border);
            margin: 1rem 0;
            padding: 1rem;
        }

        summary {
            cursor: pointer;
            color: var(--accent);
        }

        .word {
            font-weight: bold;
        }

        .pronunciation-button {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--accent);
            cursor: pointer;
            font-family: var(--body-font);
            margin-left: 0.5rem;
            padding: 0.1rem 0.4rem;
        }

        .pronunciation-button:hover {
            background: var(--accent);
            color: var(--background);
        }

        .site-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 0.75rem;
            background: var(--background);
        }

        .site-footer a {
            color: var(--muted);
            line-height: 0;
        }

        .site-footer a:hover {
            color: var(--accent);
        }

        .github-icon {
            width: 1.5rem;
            height: 1.5rem;
        }

        .theme-controls {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 1rem;
        }

        .theme-toggle {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--accent);
            cursor: pointer;
            font-family: var(--body-font);
            padding: 0.25rem 0.5rem;
        }

        .theme-toggle:hover {
            background: var(--accent);
            color: var(--background);
        }
    </style>
</head>

<body>
<main>
    <div class="theme-controls">
        <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Switch to dark mode"
        >
            ☾ Dark
        </button>
    </div>

    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <a
        href="https://github.com/necrux/words.necrux.com"
        aria-label="View project source on GitHub"
        title="View project source on GitHub"
    >
        <svg
            class="github-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
            <path
                fill="currentColor"
                d="M12 .297c-6.63 0-12 5.373-12 12
                   0 5.303 3.438 9.8 8.205 11.385
                   .6.113.82-.258.82-.577
                   0-.285-.01-1.04-.015-2.04
                   -3.338.724-4.042-1.61-4.042-1.61
                   -.546-1.387-1.333-1.756-1.333-1.756
                   -1.089-.745.084-.729.084-.729
                   1.205.084 1.84 1.237 1.84 1.237
                   1.07 1.835 2.809 1.305 3.495.998
                   .108-.776.418-1.305.762-1.605
                   -2.665-.3-5.466-1.332-5.466-5.93
                   0-1.31.465-2.38 1.235-3.22
                   -.135-.303-.54-1.523.105-3.176
                   0 0 1.005-.322 3.3 1.23
                   .96-.267 1.98-.399 3-.405
                   1.02.006 2.04.138 3 .405
                   2.28-1.552 3.285-1.23 3.285-1.23
                   .645 1.653.24 2.873.12 3.176
                   .765.84 1.23 1.91 1.23 3.22
                   0 4.61-2.805 5.625-5.475 5.92
                   .42.36.81 1.096.81 2.22
                   0 1.606-.015 2.896-.015 3.286
                   0 .315.21.69.825.57
                   C20.565 22.092 24 17.592 24 12.297
                   c0-6.627-5.373-12-12-12"
            />
        </svg>
    </a>
</footer>

<script>
    const themeToggle = document.querySelector("#theme-toggle");

    function setTheme(dark) {
        document.documentElement.classList.toggle("dark", dark);

        themeToggle.textContent = dark
            ? "☀ Light"
            : "☾ Dark";

        themeToggle.setAttribute(
            "aria-label",
            dark
                ? "Switch to light mode"
                : "Switch to dark mode"
        );
    }

    const savedTheme = localStorage.getItem("theme");

    if (savedTheme === "dark") {
        setTheme(true);
    } else if (savedTheme === "light") {
        setTheme(false);
    } else {
        setTheme(
            window.matchMedia(
                "(prefers-color-scheme: dark)"
            ).matches
        );
    }

    themeToggle.addEventListener("click", () => {
        const dark =
            !document.documentElement.classList.contains("dark");

        setTheme(dark);

        localStorage.setItem(
            "theme",
            dark ? "dark" : "light"
        );
    });
</script>

<script>
    function speakWord(word) {
        if (!("speechSynthesis" in window)) {
            return;
        }

        window.speechSynthesis.cancel();

        const utterance = new SpeechSynthesisUtterance(word);
        utterance.lang = "{{ display.speech.language }}";
        utterance.rate = {{ display.speech.rate }};

        window.speechSynthesis.speak(utterance);
    }

    document.querySelectorAll(".speech-button").forEach(button => {
        button.addEventListener("click", () => {
            speakWord(button.dataset.word);
        });
    });
</script>

</body>
</html>
