<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{{ display.site.title }}{% endblock %}</title>

    <style>
        :root {
            --background: {{ display.colors.background }};
            --foreground: {{ display.colors.foreground }};
            --accent: {{ display.colors.accent }};
            --muted: {{ display.colors.muted }};
            --border: {{ display.colors.border }};

            --body-font: {{ display.fonts.body }};
            --heading-font: {{ display.fonts.heading }};
            --body-size: {{ display.font_sizes.body }};
            --max-width: {{ display.layout.max_width }};
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--background);
            color: var(--foreground);
            font-family: var(--body-font);
            font-size: var(--body-size);
            line-height: 1.6;
            margin: 0;
        }

        main {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 2rem;
        }

        a {
            color: var(--accent);
        }

        h1,
        h2,
        h3 {
            font-family: var(--heading-font);
        }

        details {
            border: 1px solid var(--border);
            margin: 1rem 0;
            padding: 1rem;
        }

        summary {
            cursor: pointer;
            color: var(--accent);
        }

        .word {
            font-weight: bold;
        }

        .pronunciation-button {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--accent);
            cursor: pointer;
            font-family: var(--body-font);
            margin-left: 0.5rem;
            padding: 0.1rem 0.4rem;
        }

        .pronunciation-button:hover {
            background: var(--accent);
            color: var(--background);
        }
    </style>
</head>

<body>
<main>
    {% block content %}{% endblock %}
</main>

<script>
    function speakWord(word) {
        if (!("speechSynthesis" in window)) {
            return;
        }

        window.speechSynthesis.cancel();

        const utterance = new SpeechSynthesisUtterance(word);
        utterance.lang = "{{ display.speech.language }}";
        utterance.rate = {{ display.speech.rate }};

        window.speechSynthesis.speak(utterance);
    }

    document.querySelectorAll(".speech-button").forEach(button => {
        button.addEventListener("click", () => {
            speakWord(button.dataset.word);
        });
    });
</script>

</body>
</html>
