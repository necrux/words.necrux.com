{% extends "base.html.j2" %}

{% block title %}
{{ test.title }} | {{ display.site.title }}
{% endblock %}

{% block content %}

<h1>Test {{ test.number }}</h1>

{% if test.notes %}
<p>
    <strong>Notes:</strong>
    {{ test.notes }}
</p>
{% endif %}

{% if test.dateGiven or test.testDate %}
<p>
    {% if test.dateGiven %}
        <strong>Words Given:</strong>
        {{ test.dateGiven }}
    {% endif %}

    {% if test.dateGiven and test.testDate %}
        <br>
    {% endif %}

    {% if test.testDate %}
        <strong>Test Date:</strong>
        {{ test.testDate }}
    {% endif %}
</p>
{% endif %}

{% if test.is_latest %}
<p>
    <a href="practice.html">
        Practice Spelling Test
    </a>
</p>
{% endif %}

<h2>Words</h2>

<ul>
{% for word in test.enriched_words %}
    <li>
        <strong>{{ word.word }}</strong>

        {% if word.audio %}
        <button
            type="button"
            class="audio-button"
            data-audio="{{ word.audio }}"
            aria-label="Play recorded pronunciation of {{ word.word }}"
        >
            🔊 Recorded
        </button>
        {% endif %}

        <button
            type="button"
            class="speech-button"
            data-word="{{ word.word }}"
            aria-label="Hear browser pronunciation of {{ word.word }}"
        >
            🗣️ Speak
        </button>

        <details>
            <summary>Definition</summary>

            {% if word.part_of_speech %}
            <p>
                <strong>Part of Speech:</strong>
                {{ word.part_of_speech }}
            </p>
            {% endif %}

            {% if word.definition %}
            <p>
                <strong>Definition:</strong>
                {{ word.definition }}

                <button
                    type="button"
                    class="speech-button"
                    data-word="{{ word.definition }}"
                    aria-label="Hear browser pronunciation of definition"
                >
                    🗣️ Read
                </button>
            </p>
            {% endif %}

            {% if word.pronunciation %}
            <p>
                <strong>Pronunciation:</strong>

                <span class="pronunciation">
                    {% for syllable in word.pronunciation %}
                        {% if syllable.stress == 1 %}
                            <strong>{{ syllable.text }}</strong>
                        {% else %}
                            {{ syllable.text }}
                        {% endif %}

                        {% if not loop.last %}-{% endif %}
                    {% endfor %}
                </span>
            </p>
            {% endif %}

        </details>
    </li>
{% endfor %}
</ul>

{% if test.enriched_challenge_words %}
<h2>Challenge Words</h2>

<ul>
{% for word in test.enriched_challenge_words %}
    <li>
        <strong>{{ word.word }}</strong>

        {% if word.audio %}
        <button
            type="button"
            class="audio-button"
            data-audio="{{ word.audio }}"
            aria-label="Play recorded pronunciation of {{ word.word }}"
        >
            🔊 Recorded
        </button>
        {% endif %}

        <button
            type="button"
            class="speech-button"
            data-word="{{ word.word }}"
            aria-label="Hear browser pronunciation of {{ word.word }}"
        >
            🗣️ Speak
        </button>

        <details>
            <summary>Definition</summary>

            {% if word.part_of_speech %}
            <p>
                <strong>Part of Speech:</strong>
                {{ word.part_of_speech }}
            </p>
            {% endif %}

            {% if word.definition %}
            <p>
                <strong>Definition:</strong>
                {{ word.definition }}

                <button
                    type="button"
                    class="speech-button"
                    data-word="{{ word.definition }}"
                    aria-label="Hear browser pronunciation of definition"
                >
                    🗣️ Read
                </button>
            </p>
            {% endif %}

            {% if word.pronunciation %}
            <p>
                <strong>Pronunciation:</strong>

                {% for syllable in word.pronunciation %}
                    {% if syllable.stress == 1 %}
                        <strong>{{ syllable.text }}</strong>
                    {% else %}
                        {{ syllable.text }}
                    {% endif %}

                    {% if not loop.last %}-{% endif %}
                {% endfor %}
            </p>
            {% endif %}

        </details>
    </li>
{% endfor %}
</ul>
{% endif %}

<p>
    <a href="../index.html">← Back to Home</a>
</p>

{% endblock %}